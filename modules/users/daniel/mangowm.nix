{
  config,
  lib,
  ...
} @ outer: let
  xkb = {
    layout = "us,gb";
    variant = "dvorak,";
    options = "caps:swapescape,grp:ctrls_toggle";
  };
in {
  users.daniel.mangowm = {pkgs, ...}: {
    imports = with outer.config.modules; [mangowm xf86];

    home-manager.users.daniel = {config, ...}: let
      # Mapping all XF86 keys produces lots of errors because not every XF86 key corresponds to a physical key.
      # Workaround is to compile the chosen keyboard layouts
      # then filter for only the keys in the layout
      validKeycodes = import (pkgs.runCommand "valid-xf86-keys.nix" {
          nativeBuildInputs = [pkgs.libxkbcommon pkgs.gnugrep pkgs.coreutils pkgs.gnused];
        } ''
          { echo '{'
            xkbcli compile-keymap \
              --layout  '${xkb.layout}' \
              --variant '${xkb.variant}' \
              --options '${xkb.options}' \
              | grep -oE 'XF86[A-Za-z0-9_]+' \
              | sort -u \
              | sed 's/.*/  "&" = true;/'
            echo '}'
          } > $out
        '');

      xf86Keybinds = lib.pipe config.xf86 [
        (lib.filterAttrs (_: {
          cmd,
          keycode,
          ...
        }:
          cmd
          != null
          # Hack: because most keyboards have a single play/pause button, they resolve to the same keysym
          # That causes a conflicting keybind
          # So we need to filter out one, so pause gets the axe
          && keycode != config.xf86.audioPause.keycode))
        (lib.mapAttrs' (_: v: lib.nameValuePair v.keycode v))
        (builtins.intersectAttrs validKeycodes)
        (lib.concatMapAttrsStringSep "\n"
          (keycode: {cmd, ...}: "bind=NONE,${keycode},spawn,${cmd}"))
      ];
    in {
      xdg.configFile."mango/config.conf".text = let
        mod = "SUPER";
      in ''
        exec=pkill waybar; waybar

        animations=0
        cursor_hide_timeout=3
        cursor_hide_on_keypress=1

        # Input configuration
        numlock_on=1
        xkb_rules_layout=${xkb.layout}
        xkb_rules_variant=${xkb.variant}
        xkb_rules_options=${xkb.options}

        # Keybinds
        # binds=${mod},a,
        # binds=${mod},b,
        # binds=${mod},c,
        # binds=${mod},d,
        # binds=${mod},e,
        binds=${mod},f,togglefullscreen
        binds=${mod},g,togglegaps
        # binds=${mod},h,
        # binds=${mod},i,
        binds=${mod},j,focusstack,next
        binds=${mod},k,focusstack,prev
        # binds=${mod},l,
        binds=${mod},m,spawn,${config.xf86.music.cmd}
        # binds=${mod},n,
        # binds=${mod},o,
        binds=${mod},p,spawn,${config.xf86.audioPlay.cmd}
        binds=${mod},q,killclient
        # binds=${mod},r,
        # binds=${mod},s,
        # binds=${mod},t,
        # binds=${mod},u,
        # binds=${mod},v,
        binds=${mod},w,spawn,${config.xf86.WWW.cmd}
        binds=${mod},x,spawn,${config.xf86.explorer.cmd}
        # binds=${mod},y,
        # binds=${mod},z,

        binds=${mod},comma,spawn,${config.xf86.audioPrev.cmd}
        binds=${mod},period,spawn,${config.xf86.audioNext.cmd}
        bind=${mod},Return,spawn,${config.xf86.terminal.cmd}
        bind=ALT,Space,spawn_shell,wofi -S drun -I

        bind=${mod},1,view,1
        bind=${mod},2,view,2
        bind=${mod},3,view,3
        bind=${mod},4,view,4
        bind=${mod},5,view,5
        bind=${mod},6,view,6
        bind=${mod},7,view,7
        bind=${mod},8,view,8
        bind=${mod},9,view,9

        bind=${mod}+SHIFT,1,tag,1
        bind=${mod}+SHIFT,2,tag,2
        bind=${mod}+SHIFT,3,tag,3
        bind=${mod}+SHIFT,4,tag,4
        bind=${mod}+SHIFT,5,tag,5
        bind=${mod}+SHIFT,6,tag,6
        bind=${mod}+SHIFT,7,tag,7
        bind=${mod}+SHIFT,8,tag,8
        bind=${mod}+SHIFT,9,tag,9


        # XF86 Keybinds (autogenerated)
        ${xf86Keybinds}
      '';
    };
  };
}
